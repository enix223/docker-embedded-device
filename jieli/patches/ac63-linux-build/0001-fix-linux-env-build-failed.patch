From 68704bfddc86d13756d36112819b93d510ab1f69 Mon Sep 17 00:00:00 2001
From: Enix Yu <enix223@163.com>
Date: Wed, 11 Mar 2026 11:24:55 +0800
Subject: [PATCH 1/2] fix: linux env build failed

(cherry picked from commit 7306492dfb7a2c5691f7efb06cb015de73a625a5)
---
 cpu/bd19/tools/download.c                     |  22 ++++++++----
 .../tools/download/data_trans/download.sh     |  33 ++++++++++++++++++
 cpu/bd19/tools/isd_download                   | Bin 0 -> 10277648 bytes
 3 files changed, 48 insertions(+), 7 deletions(-)
 create mode 100644 cpu/bd19/tools/download/data_trans/download.sh
 create mode 100755 cpu/bd19/tools/isd_download

diff --git a/cpu/bd19/tools/download.c b/cpu/bd19/tools/download.c
index 8f9c608..872b464 100644
--- a/cpu/bd19/tools/download.c
+++ b/cpu/bd19/tools/download.c
@@ -5,6 +5,8 @@
 
 ##!/bin/sh
 
+cd "$(dirname "$0")"
+
 ${OBJDUMP} -D -address-mask=0x1ffffff -print-dbg $1.elf > $1.lst
 ${OBJCOPY} -O binary -j .text $1.elf text.bin
 ${OBJCOPY} -O binary -j .data $1.elf data.bin
@@ -31,15 +33,21 @@ lz4_packet -dict text.bin -input common.bin 0 $bank_files -o bank.bin
 ${OBJDUMP} -section-headers -address-mask=0x1ffffff $1.elf
 ${OBJSIZEDUMP} -lite -skip-zero -enable-dbg-info $1.elf | sort -k 1 > symbol_tbl.txt
 
-cat text.bin data.bin data_code.bin aec.bin aac.bin bank.bin aptx.bin > app.bin
-
-/opt/utils/strip-ini -i isd_config.ini -o isd_config.ini
+cat text.bin data.bin data_code.bin aec.bin aac.bin bank0.bin aptx.bin > app.bin
 
-/* files="app.bin ${CPU}loader.* uboot*  ota*.bin p11_code.bin isd_config.ini isd_download.exe fw_add.exe ufw_maker.exe" */
-files="app.bin ${CPU}loader.* uboot*  ota*.bin p11_code.bin isd_config.ini flash_params.bin"
-NICKNAME="${CPU}_sdk"
+rm -f bank*.bin common.bin text.bin data.bin bank.bin aac.bin aec.bin aptx.bin
 
-host-client -project ${NICKNAME}$2 -f ${files} $1.elf
+#ifdef CONFIG_WATCH_CASE_ENABLE
+bash download/watch/download.sh
+#elif defined(CONFIG_SOUNDBOX_CASE_ENABLE)
+bash download/soundbox/download.sh
+#elif defined(CONFIG_EARPHONE_CASE_ENABLE)
+bash download/earphone/download.sh
+#elif defined(CONFIG_HID_CASE_ENABLE) ||defined(CONFIG_SPP_AND_LE_CASE_ENABLE)||defined(CONFIG_MESH_CASE_ENABLE)||defined(CONFIG_DONGLE_CASE_ENABLE)    //数传
+bash download/data_trans/download.sh
+#else
+//to do other case
+#endif  //endif app_case
 
 #else
 
diff --git a/cpu/bd19/tools/download/data_trans/download.sh b/cpu/bd19/tools/download/data_trans/download.sh
new file mode 100644
index 0000000..f904ba7
--- /dev/null
+++ b/cpu/bd19/tools/download/data_trans/download.sh
@@ -0,0 +1,33 @@
+#!/bin/bash
+
+# Change to script directory
+cd "$(dirname "$0")" || exit 1
+
+echo "Copying files..."
+cp -v "../../tone.cfg" \
+      "../../cfg_tool.bin" \
+      "../../app.bin" \
+      "../../bd19loader.bin" \
+      "../../p11_code.bin" \
+      "../../script.ver" \
+      "../../flash_params.bin" .
+
+echo "Running isd_download..."
+"../../isd_download" "../../isd_config.ini" -tonorflash -dev bd19 -boot 0x2000 -div8 -wait 300 -uboot "../../uboot.boot" -app "../../app.bin" "../../cfg_tool.bin" -res "../../p11_code.bin" -uboot_compress -flash-params flash_params.bin || exit 1
+
+echo "Cleaning up..."
+rm -f *.mp3 *.PIX *.TAB *.res *.sty
+
+echo "Generating upgrade file..."
+"../../fw_add" -noenc -fw jl_isd.fw -add "../../ota.bin" -type 100 -out jl_isd.fw
+"../../fw_add" -noenc -fw jl_isd.fw -add script.ver -out jl_isd.fw
+
+echo "Creating UFW file..."
+"../../ufw_maker" -fw_to_ufw jl_isd.fw
+cp -v jl_isd.ufw update.ufw
+rm -f jl_isd.ufw
+
+echo "Waiting 2 seconds..."
+sleep 2
+
+echo "Done!"
\ No newline at end of file
